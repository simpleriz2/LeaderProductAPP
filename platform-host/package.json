{
  "name": "LeaderProductFork",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8091 --no-packager",
    "lint": "eslint .",
    "start": "react-native start --port 8091 --host 127.0.0.1",
    "test": "jest",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/android/index.android.bundle --assets-dest build/android",
    "build:web": "rspack build --config rspack.web.cjs",
    "test:recovery": "node --experimental-strip-types --test dev/recovery/diskStore.test.cjs",
    "bundle:android:dev": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output build/android-dev/index.android.bundle --assets-dest build/android-dev",
    "test:http": "node --experimental-strip-types --test dev/http/redirect.test.cjs",
    "test:crypto": "node --experimental-strip-types --test dev/crypto/webTrust.test.cjs",
    "test:remote-packages": "node --experimental-strip-types --test dev/release/remotePackages.test.cjs",
    "test:runtime": "node --test dev/runtime/identity.test.cjs",
    "test:pilot-delivery": "node --experimental-strip-types --test dev/release/pilotDelivery.test.cjs",
    "test:web-storage": "node scripts/testWebStorage.cjs",
    "test:database": "node --experimental-strip-types --test dev/database/moduleDatabase.test.cjs",
    "bundle:android:loader": "react-native bundle --platform android --dev false --entry-file dev/native/loader-entry.ts --bundle-output build/native-loader/index.android.bundle --assets-dest build/native-loader"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@callstack/repack": "5.4.4",
    "@module-federation/enhanced": "2.9.3",
    "@playwright/test": "1.65.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@rspack/cli": "1.7.12",
    "@rspack/core": "1.7.12",
    "@swc/helpers": "0.5.24",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
